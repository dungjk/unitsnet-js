{
  "name": "@dungjk/unitsnet-js",
  "version": "5.75.1",
  "definitionVersion": "6.0.0-pre021",
  "description": "A better way to hold unit variables and easily convert to the destination unit",
  "scripts": {
    "prepublishOnly": "npm run generate && npm run test",
    "build": "rolldown -c && node scripts/flatten-dts.js",
    "generate": "cd generator-scripts && npm run generate && cd .. && npm run build",
    "test": "mocha -r ts-node/register tests/**/*.spec.ts",
    "cover": "node \"node_modules/nyc/bin/nyc.js\" --reporter=lcov --reporter=text-summary npm run test"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "directories": {
    "lib": "dist"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/dungjk/unitsnet-js.git"
  },
  "homepage": "https://github.com/dungjk/unitsnet-js",
  "author": "Haim Kastner, Based on UnitsNet Project",
  "license": "MIT",
  "devDependencies": {
    "@types/chai": "^4.2.12",
    "@types/mocha": "^5.2.7",
    "@types/node": "^12.12.62",
    "@types/numeral": "^2.0.5",
    "axios": "^1.8.4",
    "chai": "^4.2.0",
    "mocha": "^12.0.3",
    "numeral": "^2.0.6",
    "nyc": "^18.0.0",
    "rolldown": "^1.2.14",
    "rolldown-plugin-dts": "^0.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "xml2js": "^0.6.2"
  },
  "keywords": [
    "conversion",
    "units-of-measure",
    "units",
    "quantities",
    "unit-converter",
    "converter",
    "unit",
    "measure",
    "measures",
    "measurement",
    "measurements"
  ]
}
